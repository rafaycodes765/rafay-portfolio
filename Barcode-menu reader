import cv2 # ✅ Uncommented import
import qrcode
import json
import tkinter as tk
from tkinter import messagebox
from pyzbar.pyzbar import decode
import webbrowser
menu_data = {
&quot;restaurant&quot;: &quot;Tasty Bites&quot;,

&quot;BBQ&quot;: [
{&quot;name&quot;: &quot;Chicken BBQ&quot;, &quot;price&quot;: 12.99},
{&quot;name&quot;: &quot;Beef BBQ&quot;, &quot;price&quot;: 15.99}
],
&quot;RICE SECTION&quot;: [
{&quot;name&quot;: &quot;Fried Rice&quot;, &quot;price&quot;: 8.99},
{&quot;name&quot;: &quot;Biryani&quot;, &quot;price&quot;: 10.99}
],
&quot;FAST FOOD&quot;: [
{&quot;name&quot;: &quot;Burger&quot;, &quot;price&quot;: 5.99},
{&quot;name&quot;: &quot;Pizza&quot;, &quot;price&quot;: 9.99}
],
&quot;SWEET&quot;: [
{&quot;name&quot;: &quot;Ice Cream&quot;, &quot;price&quot;: 3.99},
{&quot;name&quot;: &quot;Cake&quot;, &quot;price&quot;: 4.99}
]
}
class QRMenuApp:
def __init__(self, root):
self.root = root
self.root.title(&quot;QR Menu App&quot;)
self.root.geometry(&quot;500x700&quot;)
self.root.configure(bg=&quot;#f4f4f9&quot;)
self.menu = {}
tk.Label(root, text=&quot;Restaurant QR Menu&quot;, font=(&quot;Arial&quot;,
16, &quot;bold&quot;), bg=&quot;#f4f4f9&quot;).pack(pady=10)
tk.Button(root, text=&quot;Generate QR Code&quot;,
command=self.generate_qr, font=(&quot;Arial&quot;, 12), bg=&quot;#4CAF50&quot;,
fg=&quot;white&quot;).pack(pady=10)
tk.Button(root, text=&quot;Scan QR Code&quot;,
command=self.scan_qr_code, font=(&quot;Arial&quot;, 12), bg=&quot;#2196F3&quot;,
fg=&quot;white&quot;).pack(pady=10)
tk.Button(root, text=&quot;View Full Menu&quot;,
command=self.view_menu, font=(&quot;Arial&quot;, 12), bg=&quot;#FF9800&quot;,
fg=&quot;white&quot;).pack(pady=10)
self.menu_display = tk.Text(root, wrap=&quot;word&quot;, height=20,
width=50, bg=&quot;white&quot;, font=(&quot;Arial&quot;, 12))

self.menu_display.pack(pady=10)
def generate_qr(self):
menu_json = json.dumps(menu_data)
qr = qrcode.QRCode(version=1,
error_correction=qrcode.constants.ERROR_CORRECT_L, box_size=10,
border=4)
qr.add_data(menu_json)
qr.make(fit=True)
img = qr.make_image(fill=&quot;black&quot;, back_color=&quot;white&quot;)
img.save(&quot;restaurant_menu_qr.png&quot;)
messagebox.showinfo(&quot;Success&quot;, &quot;QR Code successfully
generated and saved as &#39;restaurant_menu_qr.png&#39;.&quot;)
def scan_qr_code(self):
cap = cv2.VideoCapture(0)
if not cap.isOpened():
messagebox.showerror(&quot;Error&quot;, &quot;Could not access the
camera.&quot;)
return
while True:
ret, frame = cap.read()
if not ret:
messagebox.showerror(&quot;Error&quot;, &quot;Failed to capture
image. Check your camera.&quot;)
break
decoded_objects = decode(frame)
for obj in decoded_objects:
data = obj.data.decode(&quot;utf-8&quot;)
try:
self.menu = json.loads(data)
self.display_menu()
self.generate_html()
cap.release()
cv2.destroyAllWindows()
return
except json.JSONDecodeError:

messagebox.showerror(&quot;Error&quot;, &quot;Error decoding
JSON from QR code.&quot;)
cv2.imshow(&#39;QR Code Scanner - Press Q to Exit&#39;, frame)
if cv2.waitKey(1) &amp; 0xFF == ord(&#39;q&#39;):
break
cap.release()
cv2.destroyAllWindows()
def display_menu(self):
menu_text = &quot;&quot;
if &quot;restaurant&quot; in self.menu:
menu_text += f&quot;�
Restaurant: {self.menu[&#39;restaurant&#39;]}\n&quot; + &quot;=&quot; * 30 + &quot;\n&quot;
for category, items in self.menu.items():
if isinstance(items, list):
menu_text += f&quot;\n�� {category}:\n&quot; + &quot;-&quot; * 25 +
&quot;\n&quot;
for item in items:
if isinstance(item, dict):
name = item.get(&quot;name&quot;, &quot;Unknown Item&quot;)
price = item.get(&quot;price&quot;, 0)
menu_text += f&quot;{name} - ${price:.2f}\n&quot;
self.menu_display.delete(1.0, tk.END)
self.menu_display.insert(tk.END, menu_text)
def generate_html(self):
html_content = &quot;&quot;&quot;
&lt;html&gt;
&lt;head&gt;
&lt;title&gt;Restaurant Menu&lt;/title&gt;
&lt;style&gt;
body {
font-family: Arial, sans-serif;
margin: 20px;
background-color: #f4f4f9;
color: #333;
}

h1 {
text-align: center;
}
.category {
background-color: #4CAF50;
color: white;
padding: 10px;
margin-top: 20px;
border-radius: 5px;
}
ul {
list-style-type: none;
padding: 0;
}
li {
padding: 5px;
}
.item-name {
font-weight: bold;
}
.item-price {
color: #d9534f;
}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;h1&gt;Restaurant Menu&lt;/h1&gt;
&quot;&quot;&quot;
if &quot;restaurant&quot; in self.menu:
html_content += f&quot;&lt;h2&gt;Welcome to
{self.menu[&#39;restaurant&#39;]}!&lt;/h2&gt;&quot;
for category in self.menu:
if category != &quot;restaurant&quot;:
html_content += f&quot;&lt;div
class=&#39;category&#39;&gt;&lt;h3&gt;{category} Menu&lt;/h3&gt;&lt;ul&gt;&quot;
for item in self.menu[category]:
html_content += f&quot;&lt;li&gt;&lt;span class=&#39;item-
name&#39;&gt;{item[&#39;name&#39;]}&lt;/span&gt; - &lt;span class=&#39;item-
price&#39;&gt;${item[&#39;price&#39;]:.2f}&lt;/span&gt;&lt;/li&gt;&quot;

html_content += &quot;&lt;/ul&gt;&lt;/div&gt;&quot;
html_content += &quot;&lt;/body&gt;&lt;/html&gt;&quot;
with open(&quot;menu.html&quot;, &quot;w&quot;) as file:
file.write(html_content)
print(&quot;Menu has been saved to &#39;menu.html&#39;.&quot;)
def view_menu(self):
webbrowser.open(&quot;menu.html&quot;)

if __name__ == &quot;__main__&quot;:
root = tk.Tk()
app = QRMenuApp(root)
root.mainloop()
